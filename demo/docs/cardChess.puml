@startuml
title Card Chess Project

left to right direction

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "com.cardchess.view" {

  ' Main Game Layout

  together {
    class GameLayout {
      - player1Area: PlayerArea
      - player2Area: PlayerArea
      - boardView: BoardView
    }

    class PlayerArea {
      - drawPile: DrawPileView
      - hand: HandView
      - discardPile: DiscardPileView
    }

    class BoardView
  }

  ' Card and Pile Views

  together {
    class HandView {
    }

    abstract class PileView {
    }

    class DrawPileView {
      - cardCount: int
    }

    class DiscardPileView {
      - topCard: CardView
    }

    class CardView {
      - card: CardInstance
    }

  }

  ' Startup View

  interface StartupView {
    + requestDataUpdate(): CompletableFuture<Boolean>
    + showUpdateError(errors: List<String>): void
    + showStartupError(error: String): void
    + showStartupComplete(): void
  }

}

package "com.cardchess.controller" {

' Game Controller

  class GameController {
    - gameState: GameState
    - nextUnitId: int
    - nextCardId: int
    + startTurn(): void
    + submitAction(player: Player, action: GameAction): void
    - executeAction(action: GameAction): void
    - checkGameOver(): boolean
  }

' Game Startup

  class GameStartupCoordinator {
    + initializeGame(): CompletableFuture<GameData>
    - checkForDataUpdates(): CompletableFuture<Boolean>
    - handleUpdateDecision(): CompletableFuture<Boolean>
    - updateGameData(): CompletableFuture<Void>
    - loadGameData(): CompletableFuture<GameData>
  }

}

package "com.cardchess.model" {

  ' Game State and Board

  together {
    class GameState {
      - board: Board
      - players: List<Player>
      - currentPlayer: Player
      - turnNumber: int
    }

    class Player {
      - deckList: DeckList
      - hand: List<CardInstance>
      - drawPile: List<CardInstance>
      - discardPile: List<CardInstance>
      - units: List<UnitInstance>
      - agent: PlayerAgent
    }

    class Board {
      - rows: int
      - columns: int
      - units: UnitInstance[][]
      + placeUnit(unit: UnitInstance, position: Position): void
      + moveUnit(unit: UnitInstance, position: Position): void
      + removeUnit(position: Position): UnitInstance
      + getUnitAt(position: Position): UnitInstance
      + containsUnit(unit: UnitInstance): boolean
      + isValidPosition(position: Position): boolean
    }

    class Position <<record>> {
      - row: int
      - column: int
    }
  }

  ' Actions

  together {
    interface GameAction

    class MoveUnitAction {
      - unit: UnitInstance
      - destination: Position
      + MoveUnitAction(unit: UnitInstance, destination: Position)
    }

    class AttackUnitAction {
      - attacker: UnitInstance
      - target: UnitInstance
      - attack: Attack
      + AttackUnitAction(attacker: UnitInstance, target: UnitInstance, attack: Attack)
    }

    class PlayCardAction {
      - card: CardInstance
      + PlayCardAction(card: CardInstance)
    }

    class DrawCardAction {
      - amount: int
      + DrawCardAction(amount: int)
    }

    class EndTurnAction {
      + EndTurnAction()
    }
  }

  ' Player Agents

  together {
    interface PlayerAgent {
      + chooseAction(gameState: GameState, player: Player): CompletableFuture<GameAction>
    }

    class HumanPlayerAgent {
      - pendingAction: CompletableFuture<GameAction>
      + chooseAction(gameState: GameState, player: Player): CompletableFuture<GameAction>
      + submitAction(action: GameAction): void
      + cancelAction(): void
    }

    class CPUPlayerAgent
  }

  ' Cards and Decks

  together {
    class DeckList {
      - cards: List<Card>
      {static} - MAX_SIZE: int = 30
    }

    abstract class Card {
      - displayName: String
      + createInstance(id: int): CardInstance
    }

    class CardInstance {
      - id: int
      - card: Card
      - owner: Player
    }

    class UnitCard {
      - unit: Unit
    }

    class AttackCard {
      - attack: Attack
    }

    class SkillCard {
      - skill: Skill
    }
  }

  ' Units and Effects

  together {
    class Unit {
      - displayName: String
      - maxHealth: int
      - attacks: List<Attack>
      - skills: List<Skill>
      - ability: Ability
      + createInstance(id: int): UnitInstance
    }

    class UnitInstance {
      - id: int
      - health: int
      - position: Position
      - owner: Player
      - unit: Unit
      + getPosition(): Position
      + getHealth(): int
      + getOwner(): Player
      + getUnit(): Unit
      + getId(): int
      + isAlive(): boolean
      + takeDamage(damage: int): void
      + heal(health: int): void
    }

    class Attack {
      - displayName: String
      - description: String
      - targetType: TargetType
      - effects: List<Effect>
    }

    class Skill {
      - displayName: String
      - description: String
      - targetType: TargetType
      - effects: List<Effect>
    }

    class Ability {
      - displayName: String
      - description: String
      - targetType: TargetType
      - effects: List<Effect>
    }

    class Effect {
      - type: EffectBehavior
      - target: EffectTarget
      - value: int
      - unitTypeIds: List<String>
    }

    class EffectContext {
      - gameState: GameState
      - source: UnitInstance
      - selectedTargets: List<UnitInstance>
      - sourcePlayer: Player
    }

    enum TargetType {
      SELECTED_TARGET
      NO_TARGET
    }

    enum EffectTarget {
      SELF
      UNIT
      ALL_UNITS
      UNIT_OF_TYPE
      ALL_UNITS_OF_TYPE
      ALLY_UNIT
      ALL_OTHER_ALLY_UNITS
      ALL_ALLY_UNITS
      ENEMY_UNIT
      ALL_ENEMIES
    }

    interface EffectBehavior {
      + execute(effect: Effect, context: EffectContext): void
      + generateDescription(effect: Effect): String
    }

    class DamageEffect
    class HealEffect
    class DrawCardEffect
    class ApplyBurnEffect

  }

}

package "com.cardchess.data" {

  class GameData {
    - effects: List<Effect>
    - attacks: List<Attack>
    - skills: List<Skill>
    - abilities: List<Ability>
    - cards: List<Card>
    - units: List<Unit>
  }
  
  class GameDataUpdateChecker {
    + checkForUpdates(): CompletableFuture<Boolean>
    - calculateFileHash(file: File): String
  }

  class ExcelToJsonConverter {
    + convert(excelFile: File, outputDirectory: File): ConversionResult
    - readWorkbook(file: File): Workbook
    - generateJsonFiles(): void
  }

  class GameDataValidator {
    + validateWorkbook(file: File): ValidationResult
    + validateJson(directory: File): ValidationResult
  }

  class GameDataLoader {
    + load(): GameData
    - loadEffects(): List<Effect>
    - loadAttacks(): List<Attack>
    - loadSkills(): List<Skill>
    - loadAbilities(): List<Ability>
    - loadCards(): List<Card>
    - loadUnits(): List<Unit>
  }

  class GameDataVersion {
    - excelHash: String
    - lastUpdated: LocalDateTime
  }

  class ValidationResult {
    - valid: boolean
    - errors: List<String>
  }

  class ConversionResult {
    - successful: boolean
    - errors: List<String>
    + isSuccessful(): boolean
    + getErrors(): List<String>
  }

  class EffectFactory {
    + createEffect(data: JsonNode): Effect
  }

  class CardFactory {
    + createCard(data: JsonNode): Card
  }

  class UnitFactory {
    + createUnit(data: JsonNode): Unit
  }

}

' Game Startup

' See GameStartupProcess.puml for the startup workflow.

' Game Startup Relationships

GameDataUpdateChecker --> GameDataVersion : checks stored version
GameStartupCoordinator ..> GameDataUpdateChecker : checks for updates
GameStartupCoordinator ..> GameDataValidator : validates data
GameStartupCoordinator ..> ExcelToJsonConverter : requests conversion
ExcelToJsonConverter ..> ConversionResult : returns
GameStartupCoordinator ..> GameDataLoader : loads game data
GameStartupCoordinator ..> StartupView : communicates with

' Game Data Conversion Relationships

GameDataLoader ..> EffectFactory : uses
GameDataLoader ..> CardFactory : uses
GameDataLoader ..> UnitFactory : uses

EffectFactory ..> Effect : creates
CardFactory ..> Card : creates
UnitFactory ..> Unit : creates

GameDataLoader ..> GameData : creates
GameStartupCoordinator ..> GameData : produces

' Game Data Relationships

GameData "1" o-- "0..*" Effect : effects
GameData "1" o-- "0..*" Attack : attacks
GameData "1" o-- "0..*" Skill : skills
GameData "1" o-- "0..*" Ability : abilities
GameData "1" o-- "0..*" Card : cards
GameData "1" o-- "0..*" Unit : units

' Model Inheritance

PlayerAgent <|.. HumanPlayerAgent
PlayerAgent <|.. CPUPlayerAgent

Card <|-- UnitCard
Card <|-- AttackCard
Card <|-- SkillCard

GameAction <|.. MoveUnitAction
GameAction <|.. AttackUnitAction
GameAction <|.. PlayCardAction
GameAction <|.. DrawCardAction
GameAction <|.. EndTurnAction

' Model Relationships

' Game State and Board

GameState "1" *-- "1" Board : board
GameState "1" *-- "2..*" Player : players
GameState "1" --> "1" Player : currentPlayer

Player "1" *-- "1" DeckList : deckList
Player "1" *-- "0..*" CardInstance : owns
Player "1" *-- "0..*" UnitInstance : owns

Board "1" -- "0..*" UnitInstance : contains

' Player Agents

Player --> PlayerAgent : controlled by

' Cards and Decks

DeckList "1" o-- "0..30" Card : definitions

CardInstance "0..*" --> "1" Card : instance of

UnitCard --> Unit : references
AttackCard --> Attack : references
SkillCard --> Skill : references

' Units and Effects

UnitInstance "0..*" --> "1" Unit : instance of

Unit "1" o-- "0..*" Attack
Unit "1" o-- "0..*" Skill
Unit "1" o-- "0..1" Ability

Attack "1" --> "0..*" Effect : effects (ordered)
Skill "1" --> "0..*" Effect : effects (ordered)
Ability "1" --> "0..*" Effect : effects (ordered)

Attack --> TargetType
Skill --> TargetType
Ability --> TargetType

EffectBehavior <|.. DamageEffect
EffectBehavior <|.. HealEffect
EffectBehavior <|.. DrawCardEffect
EffectBehavior <|.. ApplyBurnEffect

Effect --> EffectBehavior : uses
Effect --> EffectTarget

Effect ..> EffectContext : uses

EffectContext --> GameState : game state
EffectContext --> UnitInstance : source
EffectContext --> Player : source player
EffectContext --> "0..*" UnitInstance : selected targets

' View Inheritance

DrawPileView --|> PileView
DiscardPileView --|> PileView

GameStartupCoordinator ..> StartupView : communicates with

' View Composition

GameLayout "1" *-- "2" PlayerArea
GameLayout "1" *-- "1" BoardView

PlayerArea "1" *-- "1" HandView
PlayerArea "1" *-- "1" DrawPileView
PlayerArea "1" *-- "1" DiscardPileView

HandView "1" *-- "0..*" CardView
DiscardPileView "1" *-- "0..1" CardView

' View and Model Relationships

PlayerArea --> Player : displays
CardView --> CardInstance : displays
HandView ..> Player : displays hand
PileView ..> Player : displays pile
BoardView ..> Board : displays

' Controller Relationships

GameController --> GameState : manages
GameController --> Player : manages
GameController --> GameLayout : updates
GameController ..> GameAction : executes
GameController ..> EffectContext : creates

@enduml