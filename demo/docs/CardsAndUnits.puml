@startuml
title Cards and Units

left to right direction

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "com.cardchess.model" {

  ' Cards and Decks

  together {
    class DeckList {
      - cards: List<Card>
      - MAX_SIZE: int = 30
    }

    abstract class Card {
      - displayName: String
      + createInstance(id: int): CardInstance
    }

    class CardInstance {
      - id: int
      - card: Card
      - owner: Player
    }

    class UnitCard {
      - unit: Unit
    }

    class AttackCard {
      - attack: Attack
    }

    class SkillCard {
      - skill: Skill
    }
  }

  ' Units and Effects

  together {
    class Unit {
      - displayName: String
      - maxHealth: int
      - attacks: List<Attack>
      - skills: List<Skill>
      - ability: Ability
      + createInstance(id: int): UnitInstance
    }

    class UnitInstance {
      - id: int
      - health: int
      - position: Position
      - owner: Player
      - unit: Unit
      + getPosition(): Position
      + getHealth(): int
      + getOwner(): Player
      + getUnit(): Unit
      + getId(): int
      + isAlive(): boolean
      + takeDamage(damage: int): void
      + heal(health: int): void
    }

    class Attack {
      - displayName: String
      - description: String
      - damage: int
      - effects: List<Effect>
    }

    class Skill {
      - displayName: String
      - description: String
      - effects: List<Effect>
    }

    class Ability {
      - displayName: String
      - description: String
      - effects: List<Effect>
    }

    class Effect {
      - type: EffectType
      - value: int
      + apply(context: EffectContext): void
    }

    class EffectContext {
      - gameState: GameState
      - source: UnitInstance
      - targets: List<UnitInstance>
      - sourcePlayer: Player
    }
  }

  ' Supporting Types

  class Player
  class GameState
  class Position <<record>>
}

' Model Inheritance

Card <|-- UnitCard
Card <|-- AttackCard
Card <|-- SkillCard

' Model Relationships

' Cards and Decks

DeckList "1" o-- "0..30" Card : definitions

Player "1" *-- "0..*" CardInstance : owns

CardInstance "0..*" --> "1" Card : instance of

UnitCard --> Unit : references
AttackCard --> Attack : references
SkillCard --> Skill : references

' Units and Effects

Player "1" *-- "0..*" UnitInstance : owns

UnitInstance "0..*" --> "1" Unit : instance of

Unit "1" o-- "0..*" Attack
Unit "1" o-- "0..*" Skill
Unit "1" o-- "0..1" Ability

Attack "1" *-- "0..*" Effect
Skill "1" *-- "0..*" Effect
Ability "1" *-- "0..*" Effect

Effect ..> EffectContext : uses

EffectContext --> GameState
EffectContext --> UnitInstance
EffectContext --> Player

@enduml