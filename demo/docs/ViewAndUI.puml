@startuml
title View and UI

left to right direction

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "com.cardchess.view" {

  ' Main Game Layout

  together {
    class GameLayout {
      - player1Area: PlayerArea
      - player2Area: PlayerArea
      - boardView: BoardView
    }

    class PlayerArea {
      - drawPile: DrawPileView
      - hand: HandView
      - discardPile: DiscardPileView
    }

    class BoardView
  }

  ' Card and Pile Views

  together {
    class HandView {
    }

    abstract class PileView {
    }

    class DrawPileView {
      - cardCount: int
    }

    class DiscardPileView {
      - topCard: CardView
    }

    class CardView {
      - card: CardInstance
    }
  }

}

package "com.cardchess.model" {

  ' Supporting Types

  class Player
  class Board
  class CardInstance
}

' View Inheritance

DrawPileView --|> PileView
DiscardPileView --|> PileView

' View Composition

GameLayout "1" *-- "2" PlayerArea
GameLayout "1" *-- "1" BoardView

PlayerArea "1" *-- "1" HandView
PlayerArea "1" *-- "1" DrawPileView
PlayerArea "1" *-- "1" DiscardPileView

HandView "1" *-- "0..*" CardView
DiscardPileView "1" *-- "0..1" CardView

' View and Model Relationships

CardView --> CardInstance : displays
HandView ..> Player : displays hand
PileView ..> Player : displays pile
BoardView ..> Board : displays

@enduml