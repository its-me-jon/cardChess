@startuml
title Actions and Game Control

left to right direction

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "com.cardchess.controller" {

  ' Game Controller

  class GameController {
    - gameState: GameState
    - nextUnitId: int
    - nextCardId: int
    + startTurn(): void
    + submitAction(player: Player, action: GameAction): void
    - executeAction(action: GameAction): void
    - checkGameOver(): boolean
  }
}

package "com.cardchess.model" {

  ' Actions

  together {
    interface GameAction

    class MoveUnitAction {
      - unit: UnitInstance
      - destination: Position
      + MoveUnitAction(unit: UnitInstance, destination: Position)
    }

    class AttackUnitAction {
      - attacker: UnitInstance
      - target: UnitInstance
      - attack: Attack
      + AttackUnitAction(attacker: UnitInstance, target: UnitInstance, attack: Attack)
    }

    class PlayCardAction {
      - card: CardInstance
      + PlayCardAction(card: CardInstance)
    }

    class DrawCardAction {
      - amount: int
      + DrawCardAction(amount: int)
    }

    class EndTurnAction {
      + EndTurnAction()
    }
  }

  ' Player Agents

  together {
    interface PlayerAgent {
      + chooseAction(gameState: GameState, player: Player): CompletableFuture<GameAction>
    }

    class HumanPlayerAgent {
      - pendingAction: CompletableFuture<GameAction>
      + chooseAction(gameState: GameState, player: Player): CompletableFuture<GameAction>
      + submitAction(action: GameAction): void
      + cancelAction(): void
    }

    class CPUPlayerAgent
  }

  ' Effect Resolution Context

  class EffectContext {
    - gameState: GameState
    - source: UnitInstance
    - selectedTargets: List<UnitInstance>
    - sourcePlayer: Player
  }
}

' Action Inheritance

GameAction <|.. MoveUnitAction
GameAction <|.. AttackUnitAction
GameAction <|.. PlayCardAction
GameAction <|.. DrawCardAction
GameAction <|.. EndTurnAction

' Agent Inheritance

PlayerAgent <|.. HumanPlayerAgent
PlayerAgent <|.. CPUPlayerAgent

' Controller Relationships

GameController --> GameState : manages
GameController --> Player : manages
GameController ..> GameAction : executes
GameController ..> EffectContext : creates

' Action Relationships

MoveUnitAction --> UnitInstance
MoveUnitAction --> Position

AttackUnitAction --> UnitInstance : attacker / target
AttackUnitAction --> Attack

PlayCardAction --> CardInstance

' Agent Relationships

Player --> PlayerAgent : controlled by
PlayerAgent ..> GameState : evaluates
PlayerAgent ..> Player : evaluates

@enduml